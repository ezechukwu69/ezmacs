# Everything Emacs generates lives outside this repo (see early-init.el):
#   ~/.local/share/emacs-ez/   packages, history, backups, grammars, custom.el
#   ~/.cache/emacs-ez/         native-compiled files
# The entries below are a safety net in case something still lands here.
/elpa/
/eln-cache/
/var/
/etc/
/tree-sitter/
/custom.el
/auto-save-list/
/transient/
/projects.eld
/undo-fu-session/

# Generated by byte/native compilation and Emacs 31's user-lisp scraping
*.elc
*.eln
/lisp/.user-lisp-autoloads.el

# Editor / OS noise
*~
\#*\#
.\#*
.DS_Store
